{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_SDL3": "TRUE",
        "BUILD_TESTING": "ON",
        "LG_DUEL_REQUIRE_SDL3": "ON",
        "LG_DUEL_FETCH_SDL3": "ON",
        "LG_DUEL_SDL3_GIT_TAG": "8e37db5e797b6167f3a00d697d816a684bd259c7"
      }
    },
    {
      "name": "perf",
      "displayName": "Performance Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/perf",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "LG_DUEL_REQUIRE_SDL3": "ON",
        "LG_DUEL_FETCH_SDL3": "ON",
        "LG_DUEL_USE_PATCHED_SDL3": "ON",
        "LG_DUEL_SDL3_GIT_TAG": "8e37db5e797b6167f3a00d697d816a684bd259c7"
      }
    },
    {
      "name": "gpu-timing",
      "displayName": "GPU Timing Release",
      "inherits": "perf",
      "binaryDir": "${sourceDir}/build/gpu-timing",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "CMAKE_DISABLE_FIND_PACKAGE_SDL3": "TRUE",
        "BUILD_TESTING": "ON",
        "LG_DUEL_REQUIRE_SDL3": "ON",
        "LG_DUEL_FETCH_SDL3": "ON",
        "LG_DUEL_SDL3_GIT_TAG": "8e37db5e797b6167f3a00d697d816a684bd259c7"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "perf",
      "configurePreset": "perf"
    },
    {
      "name": "gpu-timing",
      "configurePreset": "gpu-timing"
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gpu-timing",
      "configurePreset": "gpu-timing",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
