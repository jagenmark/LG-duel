@SolidClass = worldspawn : "LG Duel world geometry. Use common/playerclip on every face for invisible player clipping."
[
  lg_bounds_min(string) : "Arena bounds min" : "" : "Optional x y z bounds in TrenchBroom units."
  lg_bounds_max(string) : "Arena bounds max" : "" : "Optional x y z bounds in TrenchBroom units."
]

@SolidClass = func_group : "LG Duel brush group. Use common/playerclip on every face for invisible player clipping."
[
]

@SolidClass = trigger_jumppad : "Jumppad trigger volume"
[
  target(target_destination) : "target_position targetname" : "" : "Optional target_position name for ballistic launch."
  speed(float) : "Speed" : 20 : "Optional positive fallback speed. For target launches, this is horizontal speed."
  direction(string) : "Direction fallback" : "" : "Optional fallback vector: x y z."
  angle(integer) : "Yaw fallback" : 0 : "Optional fallback yaw in degrees."
  pitch(integer) : "Pitch fallback" : 90 : "Optional fallback pitch in degrees."
]

@PointClass base(Angles) size(-16 -16 0, 16 16 56) color(0 220 80) = lg_spawn : "LG Duel player spawn"
[
  yaw(integer) : "Yaw override" : 0 : "Optional spawn yaw in degrees. The importer also accepts angle from the Angles base class."
]

@PointClass size(-8 -8 -8, 8 8 8) color(80 180 255) = target_position : "Jumppad landing target"
[
  targetname(target_source) : "Target name" : ""
  origin(string) : "Origin" : "" : "x y z position in TrenchBroom units."
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 220 96) = light_point : "Static point light"
[
  light(integer) : "Intensity" : 300 : "Quake-style intensity. 300 is the default LG Duel brightness."
  radius(integer) : "Radius" : 320 : "Light falloff radius in TrenchBroom units."
  _color(color255) : "Color" : "255 255 255" : "Static light color."
]

@PointClass color(255 240 180) size(-12 -12 -12, 12 12 12) = light_sun : "directional sun light"
[
  intensity(float) : "intensity" : 0.7
  color(color255) : "color" : "255 240 200"
  direction(string) : "direction vector x y z" : "0.3 -0.5 -1"
  angle(integer) : "yaw angle fallback" : 0
  pitch(integer) : "pitch angle fallback" : -45
]
