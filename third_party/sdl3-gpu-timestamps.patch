+static SDL_LGGPUTimestampResult VULKAN_LGGetTimestampQueryInfo(
+    SDL_GPURenderer *driverData,
+    SDL_LGGPUTimestampQueryInfo *info)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+
+    if (renderer->timestampValidBits == 0) {
+        return SDL_LG_GPU_TIMESTAMP_UNSUPPORTED;
+    }
+
+    info->timestamp_valid_bits = renderer->timestampValidBits;
+    info->timestamp_period_nanoseconds =
+        renderer->physicalDeviceProperties.properties.limits.timestampPeriod;
+    return SDL_LG_GPU_TIMESTAMP_AVAILABLE;
+}
+
+static SDL_LGGPUTimestampQueryPool *VULKAN_LGCreateTimestampQueryPool(
+    SDL_GPURenderer *driverData,
+    Uint32 queryCount)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    SDL_LGGPUTimestampQueryPool *pool;
+    VkQueryPoolCreateInfo createInfo;
+    VkResult result;
+
+    if (renderer->timestampValidBits == 0) {
+        SDL_SetError("GPU timestamp queries are not supported by this Vulkan queue");
+        return NULL;
+    }
+
+    pool = SDL_calloc(1, sizeof(*pool));
+    if (pool == NULL) {
+        return NULL;
+    }
+
+    SDL_zero(createInfo);
+    createInfo.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    createInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    createInfo.queryCount = queryCount;
+
+    result = renderer->vkCreateQueryPool(
+        renderer->logicalDevice, &createInfo, NULL, &pool->queryPool);
+    if (result != VK_SUCCESS) {
+        SDL_SetError("%s %s", "vkCreateQueryPool", VkErrorMessages(result));
+        SDL_free(pool);
+        return NULL;
+    }
+
+    pool->renderer = renderer;
+    pool->queryCount = queryCount;
+
+    SDL_LockMutex(renderer->disposeLock);
+    pool->next = renderer->timestampQueryPools;
+    renderer->timestampQueryPools = pool;
+    SDL_UnlockMutex(renderer->disposeLock);
+
+    return pool;
+}
+
+static void VULKAN_LGReleaseTimestampQueryPool(
+    SDL_GPURenderer *driverData,
+    SDL_LGGPUTimestampQueryPool *pool)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    SDL_LGGPUTimestampQueryPool **link;
+
+    SDL_LockMutex(renderer->disposeLock);
+    for (link = &renderer->timestampQueryPools; *link != NULL; link = &(*link)->next) {
+        if (*link == pool) {
+            *link = pool->next;
+            renderer->vkDestroyQueryPool(renderer->logicalDevice, pool->queryPool, NULL);
+            SDL_free(pool);
+            SDL_UnlockMutex(renderer->disposeLock);
+            return;
+        }
+    }
+    SDL_UnlockMutex(renderer->disposeLock);
+
+    SDL_SetError("Timestamp query pool does not belong to this GPU device");
+}
+
+static bool VULKAN_INTERNAL_ValidateTimestampQueryRange(
+    VulkanRenderer *renderer,
+    SDL_LGGPUTimestampQueryPool *pool,
+    Uint32 firstQuery,
+    Uint32 queryCount)
+{
+    if (pool->renderer != renderer) {
+        return SDL_SetError("Timestamp query pool does not belong to this GPU device");
+    }
+    if (firstQuery > pool->queryCount ||
+        queryCount > pool->queryCount - firstQuery) {
+        return SDL_SetError("Timestamp query range is out of bounds");
+    }
+    return true;
+}
+
+static bool VULKAN_LGResetTimestampQueries(
+    SDL_GPUCommandBuffer *commandBuffer,
+    SDL_LGGPUTimestampQueryPool *pool,
+    Uint32 firstQuery,
+    Uint32 queryCount)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanRenderer *renderer = vulkanCommandBuffer->renderer;
+
+    if (!VULKAN_INTERNAL_ValidateTimestampQueryRange(
+            renderer, pool, firstQuery, queryCount)) {
+        return false;
+    }
+    if (queryCount == 0) {
+        return true;
+    }
+
+    renderer->vkCmdResetQueryPool(
+        vulkanCommandBuffer->commandBuffer,
+        pool->queryPool,
+        firstQuery,
+        queryCount);
+    return true;
+}
+
+static bool VULKAN_LGWriteTimestamp(
+    SDL_GPUCommandBuffer *commandBuffer,
+    SDL_LGGPUTimestampQueryPool *pool,
+    Uint32 queryIndex,
+    SDL_LGGPUTimestampLocation location)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanRenderer *renderer = vulkanCommandBuffer->renderer;
+    VkPipelineStageFlagBits stage;
+
+    if (!VULKAN_INTERNAL_ValidateTimestampQueryRange(
+            renderer, pool, queryIndex, 1)) {
+        return false;
+    }
+
+    if (location == SDL_LG_GPU_TIMESTAMP_TOP_OF_PIPE) {
+        stage = VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT;
+    } else if (location == SDL_LG_GPU_TIMESTAMP_BOTTOM_OF_PIPE) {
+        stage = VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT;
+    } else {
+        return SDL_SetError("Invalid timestamp location");
+    }
+
+    renderer->vkCmdWriteTimestamp(
+        vulkanCommandBuffer->commandBuffer,
+        stage,
+        pool->queryPool,
+        queryIndex);
+    return true;
+}
